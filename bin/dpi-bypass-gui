#!/usr/bin/env python3
"""DPI Bypass GNOME arayüzü başlatıcısı."""

import os
import sys


def _add_package_path() -> None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = (
        os.path.join(os.path.dirname(here), "src"),
        "/usr/lib/dpi-bypass",
        "/usr/local/lib/dpi-bypass",
    )
    for path in candidates:
        if os.path.isdir(os.path.join(path, "dpibypass")):
            sys.path.insert(0, path)
            return


_add_package_path()


def _ensure_socket_group() -> None:
    """Kullanıcı 'dpi-bypass' grubuna yeni eklendiyse oturumu kapatmadan uygula.

    usermod ile eklenen grup, açık oturumdaki süreçlere yansımaz. Grup
    üyeliği /etc/group içinde varsa ama süreç grupları arasında yoksa,
    uygulama bir kez 'sg' ile yeniden başlatılır.
    """
    if os.environ.get("DPI_BYPASS_SG"):
        return
    socket_path = "/run/dpi-bypass/daemon.sock"
    if not os.path.exists(socket_path) or os.access(socket_path, os.R_OK | os.W_OK):
        return
    try:
        import grp
        import pwd

        group = grp.getgrnam("dpi-bypass")
        user = pwd.getpwuid(os.getuid()).pw_name
    except (ImportError, KeyError):
        return
    if group.gr_gid in os.getgroups() or user not in group.gr_mem:
        return
    if not any(os.access(os.path.join(p, "sg"), os.X_OK)
               for p in os.environ.get("PATH", "/usr/bin").split(":")):
        return
    os.environ["DPI_BYPASS_SG"] = "1"
    command = " ".join(f"'{a}'" for a in [os.path.realpath(__file__)] + sys.argv[1:])
    try:
        os.execvp("sg", ["sg", "dpi-bypass", "-c", command])
    except OSError:
        pass


_ensure_socket_group()

try:
    import gi  # noqa: F401
except ImportError:
    sys.stderr.write(
        "PyGObject (python3-gi) bulunamadı.\n"
        "Kurulum: sudo dnf install python3-gobject gtk4 libadwaita\n"
        "         sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1\n"
        "         sudo pacman -S python-gobject gtk4 libadwaita\n"
    )
    raise SystemExit(1)

from dpibypass.gui.app import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
