#!/usr/bin/env python3
"""DPI Bypass komut satırı aracı."""

import os
import sys


def _add_package_path() -> None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = (
        os.path.join(os.path.dirname(here), "src"),
        "/usr/lib/dpi-bypass",
        "/usr/local/lib/dpi-bypass",
    )
    for path in candidates:
        if os.path.isdir(os.path.join(path, "dpibypass")):
            sys.path.insert(0, path)
            return


_add_package_path()

from dpibypass.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
